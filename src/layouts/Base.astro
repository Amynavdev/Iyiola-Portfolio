---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Dock from '../components/Dock.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  active?: string;
  tone?: 'dark' | 'light';
  image?: string;
}
const { title, description = site.description, active, tone = 'light', image = '/og.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title === site.name ? `${site.name} · Electronics engineer and full stack developer` : `${title} · ${site.name}`;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'Electronics engineer and full stack developer',
  worksFor: { '@type': 'Organization', name: 'VGR Solutions' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Delhi Technological University' },
  address: { '@type': 'PostalAddress', addressLocality: 'Port Louis', addressCountry: 'MU' },
  sameAs: [site.links.linkedin, site.links.github, site.links.audiomack, site.links.instagram],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#141318" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, site.url).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
  <script is:inline>
    document.documentElement.classList.add('js');
    try { if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {}
  </script>
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 btn btn-primary">Skip to content</a>
  <Header active={active} tone={tone} />
  <main id="main"><slot /></main>
  <Footer />
  <Dock active={active} />
  <script>
    // entrances: reveal every block once it scrolls in; children of [data-stagger] cascade
    document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((g) => {
      Array.from(g.children).forEach((c, i) => {
        const el = c as HTMLElement;
        if (!el.hasAttribute('data-reveal')) el.setAttribute('data-reveal', '');
        el.style.setProperty('--d', `${Math.min(i, 8) * 0.08}s`);
      });
    });
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

    // skeletons: stop the shimmer once the image is in
    document.querySelectorAll<HTMLImageElement>('.sk > img').forEach((img) => {
      const done = () => { img.classList.add('loaded'); img.parentElement?.classList.add('sk-done'); };
      if (img.complete && img.naturalWidth) done(); else img.addEventListener('load', done, { once: true });
    });

    // theme toggle
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme !== 'dark';
      if (dark) document.documentElement.dataset.theme = 'dark'; else delete document.documentElement.dataset.theme;
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
    }));
  </script>
</body>
</html>
