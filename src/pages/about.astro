---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Hire from '../components/Hire.astro';
import CvPicker from '../components/islands/CvPicker';
import { site, cvs, certificates, toolkit } from '../data/site';
---
<Base title="About" active="about" description="About Oluwaferanmi Iyiola: electronics engineer (DTU, First Division) and full stack developer in Port Louis, Mauritius.">
  <section style="padding:140px 0 64px" class="max-[900px]:!pt-24">
    <div class="wrap grid items-center gap-16 lg:grid-cols-[minmax(0,.85fr)_minmax(0,1.15fr)] max-[900px]:gap-8">
      <div data-reveal="left" class="relative">
        <span aria-hidden="true" class="absolute bottom-0 left-1/2 aspect-square w-[86%] -translate-x-1/2 rounded-full" style="background:var(--accent-soft)"></span>
        <img src="/images/portrait-cutout-1000.webp" alt="Portrait of Oluwaferanmi Iyiola" width="1000" height="1124" loading="eager" class="relative block h-auto w-full" style="-webkit-mask-image:linear-gradient(to bottom,#000 88%,transparent);mask-image:linear-gradient(to bottom,#000 88%,transparent)" />
      </div>
      <div data-stagger>
        <h1 class="display m-0" style="font-size:clamp(40px,4.6vw,64px);line-height:1.05">{site.fullName}</h1>
        <div class="ui muted mt-2.5 text-[15px]">Electronics engineer · Software engineer · Backend and system architecture · Port Louis</div>
        <p class="lead mt-6">I trained as an electronics engineer at Delhi Technological University and have spent most of my working life in software. I never picked one lane, and I stopped apologising for it.</p>
        <p class="lead">Today I contribute to Elastik, the ERP VGR Solutions has been building for years, work on the Peda Entertainment platform, lead my agency and build AmyNav. I look for open problems no one owns, write the structure they are missing, then run it.</p>
        <div class="mt-7 flex flex-wrap gap-3"><a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a><a class="btn btn-ash" href="#cv">Get my CV</a></div>
      </div>
    </div>
  </section>
  <section id="cv" class="section" style="background:var(--surface)">
    <div class="wrap" data-reveal>
      <h2 class="h2">Pick the CV that fits your role</h2>
      <CvPicker client:visible cvs={cvs} />
    </div>
  </section>
  <section class="section">
    <div class="wrap grid gap-14 lg:grid-cols-2">
      <div data-reveal="left">
        <h2 class="h2 text-[36px]">Education</h2>
        <div class="row-line mt-5 border-b py-5" style="border-bottom-color:var(--line)">
          <div class="ui muted text-[13px]">2019 to 2023 · First Division</div>
          <div class="display mt-1 text-[22px]">BTech, Electrical, Electronics and Communications</div>
          <div class="muted mt-0.5 text-[15px]">Delhi Technological University · Minor in Computer Engineering</div>
        </div>
      </div>
      <div data-reveal="right">
        <h2 class="h2 text-[36px]">Certificates</h2>
        <div class="mt-5 flex flex-wrap gap-2" data-stagger>{certificates.map((c) => <span class="chip" style="background:var(--surface);box-shadow:0 4px 14px rgba(19,29,39,.05)">{c}</span>)}</div>
      </div>
    </div>
  </section>
  <section class="section" style="background:var(--surface)">
    <div class="wrap">
      <h2 class="h2" data-reveal>Toolkit</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {[['Engineering', toolkit.hardware], ['Languages and frameworks', toolkit.software], ['Platform', toolkit.platform]].map(([k, list]) => (
          <div data-reveal>
            <div class="ui muted text-[13px]">{k}</div>
            <div class="mt-3 flex flex-wrap gap-2" data-stagger>{(list as string[]).map((t) => <span class="chip">{t}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <Hire />
</Base>
