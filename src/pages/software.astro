---
import Base from '../layouts/Base.astro';
import Hire from '../components/Hire.astro';
import ProjectGrid from '../components/islands/ProjectGrid';
import { site, elastik, moreProjects } from '../data/site';
const nodes = [
  { t: 'WhatsApp Business', s: 'OAuth, templates, webhooks', pos: 'left:8%;top:12%' },
  { t: 'QuickBooks Online', s: 'OAuth2, ETL, scheduled sync', pos: 'right:7%;top:12%' },
  { t: 'elastik-medik', s: 'Clinical workflows', pos: 'left:3%;top:45%' },
  { t: 'AI Reports', s: 'FastAPI, SSO, sole author', pos: 'right:3%;top:45%' },
  { t: 'Print Engine V2', s: '40+ templates into one', pos: 'left:9%;bottom:12%' },
  { t: 'Serial Numbers', s: '150+ files, stock flows', pos: 'right:8%;bottom:12%' },
];
---
<Base title="Software" active="software" description="Software by Oluwaferanmi Iyiola: contributions to the Elastik ERP at VGR Solutions, his own products AmyNav, Tailor on the Go and PropertyTrack, and client builds.">
  <!-- HERO with the integration map -->
  <section style="padding:150px 0 72px" class="max-[900px]:!pb-12 max-[900px]:!pt-24">
    <div class="wrap grid items-center gap-12 lg:grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)]">
      <div data-stagger>
        <h1 class="display m-0" style="font-size:clamp(44px,5vw,72px);line-height:1.03">Software</h1>
        <p class="lead max-w-[500px] text-lg">Systems real businesses run on. PHP and Python at the core, React and Astro on top.</p>
        <div class="mt-7 flex flex-wrap gap-2">{['PHP', 'Python, FastAPI', 'C#, .NET', 'PostgreSQL, MySQL', 'React, Astro', 'WordPress', 'Socket.IO', 'Docker'].map((c) => <span class="chip">{c}</span>)}</div>
      </div>
      <div class="relative hidden h-[500px] overflow-hidden rounded-[18px] lg:block" style="background:var(--ash)" data-reveal="right">
        <svg width="100%" height="100%" viewBox="0 0 700 500" preserveAspectRatio="none" class="absolute inset-0" aria-hidden="true">
          <g stroke="var(--muted)" stroke-opacity=".45" stroke-width="1.5" fill="none" stroke-dasharray="4 6"><path d="M350 250 L140 90"/><path d="M350 250 L560 90"/><path d="M350 250 L110 250"/><path d="M350 250 L590 250"/><path d="M350 250 L150 410"/><path d="M350 250 L550 410"/></g>
        </svg>
        <div class="ui absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-2xl px-6 py-5 text-center text-sm text-white" style="background:#131d27">Integration Management<div class="mt-0.5 text-xs font-normal opacity-60">Shipped in 7 apps</div></div>
        {nodes.map((n) => <div class="ui absolute whitespace-nowrap rounded-2xl px-[18px] py-3.5 text-sm" style={`${n.pos};background:var(--surface);box-shadow:var(--shadow)`}>{n.t}<div class="mt-0.5 text-xs font-normal muted">{n.s}</div></div>)}
      </div>
    </div>
  </section>

  <!-- FLAGSHIP -->
  <section id="elastik" class="section studio" style="background:#131d27;color:#fff">
    <div class="wrap">
      <div data-stagger>
        <div class="ui text-sm" style="color:rgba(255,255,255,.55)">Sep 2023 to now · VGR Solutions, Port Louis</div>
        <h2 class="h2 mt-2.5">Elastik, the ERP I work on at VGR Solutions</h2>
        <p class="m-0 mt-4 max-w-[760px] text-[17px] leading-relaxed" style="color:rgba(255,255,255,.72)">Elastik is VGR Solutions' multi tenant ERP, CRM and CMS, built long before I joined. I am one of its heaviest contributors across 12+ repositories and 1,000+ tickets, trusted with features that cut across the whole product.</p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2" data-stagger>
        {elastik.map((f) => (
          <div class="rounded-[18px] p-[30px]" style="background:rgba(255,255,255,.05)">
            <div class="display text-2xl">{f.t}</div>
            <p class="m-0 mt-2.5 text-[15px] leading-relaxed" style="color:rgba(255,255,255,.68)">{f.d}</p>
          </div>
        ))}
      </div>
      <div class="mt-7 flex items-start gap-[18px] rounded-[18px] px-[30px] py-7" style="background:rgba(31,111,209,.16)" data-reveal>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8bb8f0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-none" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <div>
          <div class="ui text-base">From the field: a production bug, traced to the root</div>
          <p class="m-0 mt-2 max-w-[900px] text-[15px] leading-relaxed" style="color:rgba(255,255,255,.72)">Tenants could finish WhatsApp onboarding while their credentials silently failed to save. I tested my first theory against real production SQL, dropped it when the data disagreed, found a non atomic dual database commit, then shipped a live fix and a transactional repair script.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MORE PROJECTS with filter chips -->
  <section id="products" class="section">
    <div class="wrap" data-reveal><ProjectGrid client:visible projects={moreProjects} /></div>
  </section>
  <div id="clients"></div>

  <section class="studio" style="background:#131d27;color:#fff;padding:72px 0">
    <div class="wrap flex flex-wrap items-center justify-between gap-6" data-reveal>
      <h2 class="display m-0 text-[40px] leading-tight max-[900px]:text-[30px]">Need software you can trust?</h2>
      <div class="flex flex-wrap gap-3"><a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a><a class="btn btn-glass" href="/about/#cv">Software CV</a></div>
    </div>
  </section>
</Base>
