---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Hire from '../components/Hire.astro';
import MusicBand from '../components/MusicBand.astro';
import Hero from '../components/islands/Hero';
import BuildPlayer from '../components/islands/BuildPlayer';
import CodeTyper from '../components/islands/CodeTyper';
import ProjectIndex from '../components/islands/ProjectIndex';
import LeadershipMedia from '../components/islands/LeadershipMedia';
import WorldMap from '../components/islands/WorldMap';
import { site, heroChips, builds, projects, clientSites, leadership, places, jobs, certificates, toolkit } from '../data/site';
---
<Base title={site.name} tone="dark">
  <Hero client:load chips={heroChips} />

  <!-- HARDWARE -->
  <section id="hardware" class="section">
    <div class="wrap grid items-center gap-14 lg:grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)] max-[900px]:gap-8">
      <div data-reveal="left">
        <h2 class="h2">I build hardware that thinks.</h2>
        <p class="lead">EIRT is a robot that finds electronic waste, picks it up, classifies it with a deep learning model and sorts it. A Raspberry Pi on board runs it all.</p>
        <a href="/electronics/eirt/#result" class="card mt-6 flex items-center gap-4 p-5 no-underline" style="color:inherit">
          <span class="flex h-11 w-11 flex-none items-center justify-center rounded-xl" style="background:var(--accent-soft)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/></svg>
          </span>
          <span class="min-w-0"><span class="ui block text-[15px]">A Deep Learning Approach for Electronic Waste Detection, Classification, and Sorting</span><span class="muted text-[13px]">IEEE ICCCNT 2023 · 82.3% accuracy</span></span>
        </a>
        <div class="mt-5 flex flex-wrap gap-2" data-stagger>{toolkit.hardware.slice(0, 6).map((t) => <span class="chip">{t}</span>)}</div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-ink" href="/electronics/eirt/">How I built it</a>
          <a class="btn btn-ash" href="/electronics/">The whole lab</a>
        </div>
      </div>
      <div data-reveal="right"><BuildPlayer client:visible builds={builds} /></div>
    </div>
  </section>

  <!-- SOFTWARE -->
  <section id="software" class="section" style="background:var(--surface)">
    <div class="wrap grid items-center gap-14 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,.8fr)] max-[900px]:gap-8">
      <div data-reveal="scale" class="max-[1023px]:order-2"><CodeTyper client:visible /></div>
      <div data-reveal="right">
        <h2 class="h2">And the software businesses run on.</h2>
        <p class="lead">At VGR Solutions I work on Elastik, their multi tenant ERP. I built its WhatsApp Business integration end to end, then traced a production bug in it to a non atomic commit and shipped the fix and the repair.</p>
        <div class="mt-6 flex flex-wrap gap-2" data-stagger>
          {['Python', 'PHP', 'C#, .NET', 'React, Astro', 'FastAPI', 'PostgreSQL, MySQL', 'Docker'].map((t) => <span class="chip">{t}</span>)}
        </div>
        <a class="btn btn-ink mt-7" href="/software/">All software work</a>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="section studio" style="background:var(--studio);color:#f4f1ea">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <h2 class="h2">Things I've built.</h2>
        <span class="ui text-sm max-[1000px]:hidden" style="color:rgba(244,241,234,.5)">Hover a name · click to open</span>
      </div>
      <ProjectIndex client:visible projects={projects} />
      <p class="mt-7 text-[15px]" style="color:rgba(244,241,234,.55)" data-reveal>Plus client sites through my agency, thegossipears: {clientSites.join(', ')} and more.</p>
    </div>
  </section>

  <!-- LEADERSHIP -->
  <section id="leadership" class="section">
    <div class="wrap grid items-center gap-14 lg:grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)] max-[900px]:gap-8">
      <div data-reveal="left" class="max-[1023px]:order-2">
        <h2 class="h2">I write the structure, then I run it.</h2>
        <p class="lead">In 2021 I co founded the DTU International Students' Society for 700+ scholars from 35+ countries.</p>
        <ul class="m-0 mt-5 flex list-none flex-col gap-3 p-0" data-stagger>
          {leadership.facts.map((f) => (
            <li class="flex gap-3 text-base leading-normal" style="color:var(--text)"><span class="mt-2 h-1.5 w-1.5 flex-none rounded-full" style="background:var(--accent)"></span>{f.t}, {f.when}</li>
          ))}
        </ul>
        <div class="mt-7 flex flex-wrap gap-3">
          <button type="button" class="btn btn-ink" onclick="window.dispatchEvent(new Event('open-videos'))">Watch speeches and interview</button>
          <a class="btn btn-ash" href="/leadership/">The full story</a>
        </div>
      </div>
      <div data-reveal="right"><LeadershipMedia client:visible videos={leadership.videos} /></div>
    </div>
  </section>

  <!-- EDUCATION -->
  <section class="section" style="background:var(--surface)">
    <div class="wrap grid items-center gap-16 lg:grid-cols-[minmax(0,.85fr)_minmax(0,1.15fr)] max-[900px]:gap-8">
      <div class="relative" data-reveal="left">
        <Pic src="/images/graduation" widths={[700, 1200]} alt="Graduating from Delhi Technological University" class="rounded-[22px]" style="aspect-ratio:4/5;box-shadow:0 30px 60px rgba(19,29,39,.18)" imgStyle="object-position:center 30%" />
        <span class="ui absolute bottom-5 left-5 rounded-full px-4 py-2.5 text-[13px] text-white" style="background:rgba(19,29,39,.78);backdrop-filter:blur(10px)">Class of 2023</span>
      </div>
      <div data-reveal="right">
        <h2 class="h2">Trained as an engineer.</h2>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <span class="ui rounded-full px-3.5 py-2 text-[13px] text-white" style="background:var(--accent)">First Division</span>
          <span class="ui muted text-sm">New Delhi, India · 2019 to 2023</span>
        </div>
        <div class="display mt-4 text-[36px] leading-tight max-[900px]:text-[28px]">Delhi Technological University</div>
        <p class="lead mt-2.5">BTech in Electrical, Electronics and Communications Engineering, with a minor in Computer Engineering.</p>
        <div class="mt-6" data-stagger>
          <div class="row-line flex justify-between gap-4 py-3.5"><span class="ui">IEEE publication</span><span class="muted">ICCCNT 2023</span></div>
          <div class="row-line flex justify-between gap-4 py-3.5"><span class="ui">Final year project</span><span class="muted">EIRT robot</span></div>
          <div class="row-line flex justify-between gap-4 border-b py-3.5" style="border-bottom-color:var(--line)"><span class="ui">President</span><span class="muted text-right">International Students' Society</span></div>
        </div>
        <div class="ui muted mt-6 text-[13px]">Kept learning after</div>
        <div class="mt-2.5 flex flex-wrap gap-2" data-stagger>
          {certificates.slice(0, 4).map((c) => <span class="chip">{c}</span>)}
        </div>
      </div>
    </div>
  </section>

  <MusicBand />

  <!-- EXPERIENCE -->
  <section class="section">
    <div class="wrap">
      <div class="mb-7 flex flex-wrap items-end justify-between gap-5" data-reveal>
        <h2 class="h2">Experience</h2>
        <a class="btn btn-ink" href="/map/">See it on a map</a>
      </div>
      <div data-stagger>
        {jobs.map((j) => (
          <div class="flex items-baseline gap-6 border-b py-5 max-[900px]:flex-col max-[900px]:gap-1" style="border-color:var(--line)">
            <div class="ui muted w-[200px] flex-none text-sm">{j.when}</div>
            <div class="min-w-0 flex-1"><div class="display text-[25px]">{j.org}</div><div class="muted mt-1 text-[15px]">{j.what}</div></div>
            <div class="chip whitespace-nowrap">{j.tag}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MAP -->
  <section class="section studio" style="background:var(--studio);color:#f4f1ea">
    <div class="wrap">
      <h2 class="h2" data-reveal>One desk, clients worldwide.</h2>
      <p class="mb-8 mt-3 text-base" style="color:rgba(244,241,234,.7)" data-reveal>Where I studied, where I work, and who I build for remotely.</p>
      <div data-reveal><WorldMap client:visible places={places} /></div>
    </div>
  </section>

  <Hire />
</Base>
