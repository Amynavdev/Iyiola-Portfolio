---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import BuildPlayer from '../../components/islands/BuildPlayer';
import { site, builds, silicon, toolkit } from '../../data/site';
const modules = [
  ['Ultrasonic sensor', 'Finds objects ahead and avoids obstacles'],
  ['Robotic car', 'Drives the robot to the waste'],
  ['Robotic arm', 'Picks the item up'],
  ['Classification and sorting', 'EfficientNet-D2, 82.3% accuracy, on the Pi'],
  ['Pressure sensor', 'Tests the item before it is sorted'],
];
---
<Base title="Electronics" active="electronics" tone="dark" description="Hardware by Oluwaferanmi Iyiola: the EIRT e-waste robot (IEEE ICCCNT 2023), sensors, microcontrollers and chip design.">
  <PageIntro title="The lab" lead="Hardware I designed, wired and coded during my engineering degree at DTU. Real builds, filmed on the bench." dark>
    <div class="ui mt-3 text-[13px]" style="color:rgba(244,241,234,.5)">BTech, Electrical, Electronics and Communications · First Division</div>
    <div class="mt-6 flex flex-wrap gap-2">{toolkit.hardware.map((t) => <span class="chip" style="background:rgba(255,255,255,.08);color:#fff">{t}</span>)}</div>
  </PageIntro>
  <section class="studio pb-16" style="background:var(--studio);color:#f4f1ea">
    <div class="wrap" data-reveal><BuildPlayer client:visible builds={builds} detail /></div>
  </section>

  <section class="section">
    <div class="wrap grid items-center gap-14 lg:grid-cols-2">
      <div data-reveal="left">
        <div class="ui muted text-sm">Final year project · Sep 2022 to May 2023</div>
        <h2 class="h2 mt-2">EIRT: a robot that hunts e-waste</h2>
        <p class="lead">E-Waste Intelligent Robotic Technology finds electronic waste, picks it up, classifies it with a deep learning model and sorts it. Everything runs on one Raspberry Pi on board.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="btn btn-ink" href="/electronics/eirt/">Explore the robot</a>
          <a class="btn btn-ash" href="/electronics/eirt/#result">IEEE paper</a>
        </div>
      </div>
      <ol class="m-0 grid list-none gap-3 p-0" data-stagger>
        {modules.map(([t, d], i) => (
          <li class="card flex items-center gap-5 px-6 py-5">
            <span class="display w-10 text-[28px]" style="color:var(--accent)">{String(i + 1).padStart(2, '0')}</span>
            <span><span class="ui block text-base">{t}</span><span class="muted text-sm">{d}</span></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" style="background:var(--surface)">
    <div class="wrap">
      <h2 class="h2" data-reveal>Silicon, signals and simulation</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {silicon.map((s) => (
          <div class="flex flex-col gap-2.5 rounded-[18px] p-[26px]" style="background:var(--bg)">
            <span class="ui muted text-[13px]">{s.tool}</span>
            <span class="display text-[23px] leading-tight">{s.t}</span>
            <span class="text-sm leading-relaxed" style="color:var(--text)">{s.d}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="studio" style="background:var(--studio);color:#fff;padding:72px 0">
    <div class="wrap flex flex-wrap items-center justify-between gap-6" data-reveal>
      <h2 class="display m-0 text-[40px] leading-tight max-[900px]:text-[30px]">Embedded, robotics or vision role?</h2>
      <div class="flex flex-wrap gap-3"><a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a><a class="btn btn-glass" href="/about/#cv">Embedded CV</a></div>
    </div>
  </section>
</Base>
