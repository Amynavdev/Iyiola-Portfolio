---
import { nav } from '../data/site';
interface Props { active?: string; tone?: 'dark' | 'light' }
const { active, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---
<header class:list={['site-header', dark ? 'is-dark' : 'is-light']}>
  <div class="wrap flex h-[92px] items-center justify-between max-[900px]:h-16">
    <a href="/" aria-label="Home" class="logo">OI</a>
    <nav aria-label="Main" class="pill">
      {nav.map((n) => (
        <a href={n.href} class:list={['navl', active === n.key && 'on']} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <button type="button" data-theme-toggle class="tbtn" aria-label="Switch light or dark mode">
        <svg class="ic-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="ic-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href="/#contact" class="btn contact">Contact</a>
    </div>
  </div>
</header>

<script>
  const hdr = document.querySelector('.site-header');
  const onScroll = () => hdr?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header { position: fixed; left: 0; right: 0; top: 0; z-index: 40; transition: background-color 0.35s, box-shadow 0.35s, backdrop-filter 0.35s; }
  .site-header > div { transition: height 0.35s; }
  .site-header.scrolled > div { height: 72px; }
  .is-dark.scrolled { background: rgba(20, 19, 24, 0.72); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06); }
  .is-light.scrolled { background: color-mix(in srgb, var(--bg) 82%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: 0 1px 0 var(--line); }
  @media (max-width: 900px) { .site-header.scrolled > div { height: 60px; } }
  .logo { width: 42px; height: 42px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: 18px; text-decoration: none; }
  .pill { display: flex; align-items: center; gap: 2px; padding: 6px; border-radius: 999px; }
  .navl { font-family: var(--font-ui); font-weight: 700; font-size: 14px; text-decoration: none; padding: 10px 14px; border-radius: 999px; transition: background-color 0.25s, color 0.25s; }
  .tbtn { width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .contact { min-height: 46px; padding: 0 22px; }
  .ic-sun { display: none; }
  :global([data-theme="dark"]) .ic-sun { display: block; }
  :global([data-theme="dark"]) .ic-moon { display: none; }

  .is-dark .logo { background: #fff; color: #131d27; }
  .is-dark .pill { background: rgba(255, 255, 255, 0.12); }
  .is-dark .navl { color: #fff; }
  .is-dark .navl:hover, .is-dark .navl.on { background: rgba(255, 255, 255, 0.2); }
  .is-dark .tbtn { background: rgba(255, 255, 255, 0.12); color: #fff; }
  .is-dark .contact { background: #fff; color: #131d27; }

  .is-light .logo { background: var(--ink); color: var(--bg); }
  .is-light .pill { background: var(--ash); }
  .is-light .navl { color: var(--ink); }
  .is-light .navl:hover { background: var(--line); }
  .is-light .navl.on { background: var(--ink); color: var(--bg); }
  .is-light .tbtn { background: var(--ash); color: var(--ink); }
  .is-light .contact { background: var(--ink); color: var(--bg); }

  @media (max-width: 1000px) { .pill { display: none; } .contact { min-height: 44px; padding: 0 18px; font-size: 14px; } }
</style>
