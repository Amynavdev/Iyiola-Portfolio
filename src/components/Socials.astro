---
// Round icon links to every profile. tone="dark" for studio sections.
import { socials } from '../data/site';
interface Props { tone?: 'light' | 'dark'; class?: string }
const { tone = 'light', class: cls = '' } = Astro.props;
const icons: Record<string, string> = {
  linkedin: '<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4V21H3zM9.5 9.75h3.8v1.6h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-4.98c0-1.19-.02-2.72-1.66-2.72-1.66 0-1.92 1.3-1.92 2.63V21h-4z"/>',
  github: '<path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"/>',
  instagram: '<path d="M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4zm0 7.75a3.05 3.05 0 1 1 0-6.1 3.05 3.05 0 0 1 0 6.1zM17 5.9a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2zM12 3.6c2.73 0 3.06 0 4.14.06 2.77.13 4.07 1.44 4.2 4.2.05 1.08.06 1.41.06 4.14s0 3.06-.06 4.14c-.13 2.76-1.42 4.07-4.2 4.2-1.08.05-1.4.06-4.14.06s-3.06 0-4.14-.06c-2.78-.13-4.07-1.44-4.2-4.2C3.6 15.06 3.6 14.73 3.6 12s0-3.06.06-4.14c.13-2.77 1.43-4.07 4.2-4.2C8.94 3.61 9.27 3.6 12 3.6zM12 2C9.28 2 8.94 2 7.87 2.06 4.2 2.23 2.23 4.2 2.06 7.87 2 8.94 2 9.28 2 12s0 3.06.06 4.13c.17 3.67 2.14 5.64 5.81 5.81C8.94 22 9.28 22 12 22s3.06 0 4.13-.06c3.66-.17 5.65-2.14 5.81-5.81C22 15.06 22 14.72 22 12s0-3.06-.06-4.13c-.16-3.66-2.14-5.64-5.81-5.81C15.06 2 14.72 2 12 2z"/>',
  facebook: '<path d="M22 12.06A10 10 0 1 0 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.78-3.9 1.1 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.87h2.78l-.45 2.91h-2.33V22A10 10 0 0 0 22 12.06z"/>',
  audiomack: '<path d="M3 13h2v5H3zm4-4h2v12H7zm4-6h2v18h-2zm4 4h2v14h-2zm4 4h2v6h-2z"/>',
};
---
<div class:list={['socials flex flex-wrap gap-2', tone, cls]}>
  {socials.map((s) => (
    <a href={s.href} rel="me noopener" target="_blank" aria-label={s.label} title={s.label}>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons[s.k]} />
    </a>
  ))}
</div>
<style>
  .socials a { width: 40px; height: 40px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; background: var(--ash); color: var(--ink); transition: background .2s, color .2s, transform .2s; }
  .socials a:hover { background: var(--accent); color: #fff; transform: translateY(-2px); }
  .socials.dark a { background: rgba(255,255,255,.08); color: rgba(255,255,255,.85); }
  .socials.dark a:hover { background: #fff; color: #131d27; }
</style>
