---
interface Props { title: string; lead?: string; dark?: boolean; back?: { href: string; label: string } }
const { title, lead, dark = false, back } = Astro.props;
---
<section class:list={['intro', dark && 'studio']} style={dark ? 'background:var(--studio);color:#f4f1ea' : ''}>
  <div class="wrap" data-stagger>
    {back && <a href={back.href} class="ui inline-flex min-h-[44px] items-center gap-2 text-sm no-underline" style={dark ? 'color:rgba(244,241,234,.6)' : 'color:var(--muted)'}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>{back.label}</a>}
    <h1 class="display m-0" style="font-size:clamp(42px,5vw,72px);line-height:1.03">{title}</h1>
    {lead && <p class="m-0 mt-4 max-w-[640px] text-lg leading-relaxed max-[900px]:text-base" style={dark ? 'color:rgba(244,241,234,.72)' : 'color:var(--text)'}>{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .intro { padding: 150px 0 48px; }
  @media (max-width: 900px) { .intro { padding: 100px 0 32px; } }
</style>
