---
import { site } from '../data/site';
import Socials from './Socials.astro';
---
<section id="contact" class="studio" style="background:#131d27;color:#fff;padding:96px 0 96px">
  <div class="wrap" data-stagger>
    <h2 class="display m-0" style="font-size:clamp(38px,5vw,68px);line-height:1.05">Hiring for embedded or software?</h2>
    <p class="m-0 mt-4 max-w-[560px] text-lg" style="color:rgba(255,255,255,.7)">Pick the CV that fits the role, or just email me. I reply within a day.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a>
      <a class="btn btn-glass" href="/about/#cv">Embedded CV</a>
      <a class="btn btn-glass" href="/about/#cv">Software CV</a>
    </div>
    <div class="ui mt-9 text-[13px]" style="color:rgba(255,255,255,.55)">Or find me on</div>
    <Socials tone="dark" class="mt-3" />
  </div>
</section>
